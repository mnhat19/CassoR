# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (local dev / Render persistent disk)
DATABASE_URL=sqlite+aiosqlite:///./cassor_hrm.db

# PostgreSQL (Supabase / Railway — recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/cassor_hrm

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins (used by CORS middleware)
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ── Payment ───────────────────────────────────────────────────────────────────
# Bank account that receives customer payments (Talent Radar: 3,000 VND/analysis)
PAYMENT_BANK_NAME=MB Bank
PAYMENT_BANK_ACCOUNT=your_bank_account_number
PAYMENT_BANK_ACCOUNT_NAME=YOUR FULL NAME

# Price per analysis (VND) — default 3000
PAYMENT_AMOUNT_VND=3000

# Shared secret between the server and the Android merchant app.
# MUST be changed before going live. Use a long random string (32+ chars).
PAYMENT_WEBHOOK_SECRET=change-me-use-a-long-random-string

# How long an uploaded file is kept in memory before expiry (seconds)
PAYMENT_FILE_EXPIRY_SECONDS=1800
